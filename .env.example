# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub App (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=123456
# Paste the PEM private key. In Vercel, store literal newlines as \n.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Webhook secret configured in the GitHub App
GITHUB_WEBHOOK_SECRET=replace-with-random-secret
# Optional: comma-separated installation IDs to limit scope
# GITHUB_INSTALLATION_IDS=111111,222222

# Discord Application (Developer Portal)
DISCORD_PUBLIC_KEY=your-discord-public-key
DISCORD_APPLICATION_ID=your-application-id
DISCORD_BOT_TOKEN=your-bot-token
# Discord channel webhooks (Channel Settings > Integrations > Webhooks)
DISCORD_UPDATES_WEBHOOK_URL=https://discord.com/api/webhooks/.../...
DISCORD_WEEKLY_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# AI summarizer (OpenAI-compatible by default)
# AI_PROVIDER=openai-compatible|anthropic-messages
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Protect cron/manual endpoints. Set the same value in Vercel Cron (automatic) or when calling manually.
CRON_SECRET=replace-with-random-secret

# Optional
# LOG_DEBUG=false
