# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub App (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=123456
# Paste the PEM private key. In Vercel, store literal newlines as \n.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Webhook secret configured in the GitHub App
GITHUB_WEBHOOK_SECRET=replace-with-random-secret
# Optional: comma-separated installation IDs to limit scope
# GITHUB_INSTALLATION_IDS=111111,222222

# Discord Application (Developer Portal)
DISCORD_PUBLIC_KEY=your-discord-public-key
DISCORD_APPLICATION_ID=your-application-id
DISCORD_BOT_TOKEN=your-bot-token
# Discord channel webhooks (Channel Settings > Integrations > Webhooks)
DISCORD_UPDATES_WEBHOOK_URL=https://discord.com/api/webhooks/.../...
DISCORD_WEEKLY_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# AI summarizer (configurable). Weekly reports fall back gracefully if unavailable.
# AI_PROVIDER=openai-compatible|anthropic-messages|cloudflare
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Cloudflare Workers AI (use when AI_PROVIDER=cloudflare)
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# AI_MODEL=@cf/ibm-granite/granite-4.0-h-micro
# AI_API_KEY=your-cloudflare-api-token (Workers AI permission)

# REQUIRED for public/production deployments.
# Protects /api/cron/weekly and /api/github/sync. Vercel Cron sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-long-random-secret

# Optional
# LOG_DEBUG=false

# Direct Postgres connection (optional, enables SQL aggregation in lib/stats.ts).
# If unset, the app falls back to the Supabase PostgREST client.
# Get it from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" (port 5432) or "Transaction pooler" (port 6543) string.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct Postgres connection (optional, enables SQL aggregation in the weekly report).
# Get it from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" (port 5432) or "Transaction pooler" (port 6543) string.
# Leave unset to fall back to the PostgREST client.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
